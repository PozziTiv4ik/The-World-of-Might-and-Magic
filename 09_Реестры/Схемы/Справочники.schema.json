{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "type", "status", "canon_level", "updated_real_date"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "active"},
    "canon_level": {"const": "support"},
    "updated_real_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "description": {"type": "string"}
  },
  "oneOf": [
    {
      "properties": {
        "type": {"const": "character_status_dictionary"},
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "alive", "meaning"],
            "properties": {
              "value": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
              "alive": {"type": ["boolean", "null"]},
              "meaning": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "synonyms": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z_]*$"}
        }
      },
      "required": ["statuses", "synonyms"]
    },
    {
      "properties": {
        "type": {"const": "stale_context_markers"},
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "pattern", "message"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "name": {"type": "string", "minLength": 1},
              "pattern": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1},
              "basis_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["markers"]
    }
  ]
}
